# KisanConnect Environment Configuration Example
# Copy this to .env and fill in your actual values

# ============================================================
# DJANGO CORE CONFIGURATION
# ============================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================================
# MAIN DATABASE (KisanConnect Business Database)
# ============================================================
# For local development, SQLite is used by default
# For production, use Postgres: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ============================================================
# CHATBOT DATABASE (SEPARATE from main database)
# ============================================================
# This is the SEPARATE database for chatbot conversation data
# Must be different from the main DATABASE_URL
# Examples:
#   Local SQLite: sqlite:///./chatbot.sqlite3
#   Supabase PostgreSQL: postgresql://user:password@db.supabase.co:5432/postgres
# IMPORTANT: Do NOT expose service role key to frontend
CHAT_DATABASE_URL=sqlite:///./chatbot.sqlite3

# If using Supabase, configure these separately (server-side only):
# CHAT_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# CHAT_SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# ============================================================
# GROQ LLM CONFIGURATION (for Farmer AI Assistant)
# ============================================================
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=REPLACE_WITH_REAL_GROQ_KEY

# Available models (check Groq docs for latest):
# - llama-3.3-70b-versatile
# - llama-3.1-8b-instant
# - gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# CHATBOT CONFIGURATION
# ============================================================
# Number of recent messages to include in LLM context (default: 15)
CHAT_RECENT_MESSAGE_LIMIT=15

# Number of messages before summarization is triggered (default: 30)
CHAT_SUMMARY_THRESHOLD=30

# Maximum tool calls allowed per LLM turn (default: 5)
CHAT_MAX_TOOL_CALLS_PER_TURN=5

# ============================================================
# BREVO (SENDINBLUE) EMAIL CONFIGURATION
# ============================================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-email@example.com
BREVO_SENDER_NAME=KisanConnect Platform

# Django Email Backend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=your-email@example.com

# ============================================================
# RAZORPAY PAYMENT CONFIGURATION
# ============================================================
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# ============================================================
# EXTERNAL API KEYS
# ============================================================
# XAI (Alternative LLM provider, if used elsewhere)
XAI_API_KEY=

# Government Data API
DATA_GOV_API_KEY=579b464db66ec23bdd0000019228fb754511484d716abd00acc9d191
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# SMS Gateway (for notifications)
SMS_GATEWAY_KEY=
SMS_GATEWAY_URL=

# ElevenLabs (for voice features, if used)
ELEVENLABS_API_KEY=

# OpenWeather API (for weather data)
OPENWEATHER_API_KEY=

# ============================================================
# FILE STORAGE CONFIGURATION
# ============================================================
MEDIA_ROOT=media
MAX_UPLOAD_SIZE_MB=10

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Allow requests from these origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ============================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================
# SOP Engine URL
SOP_ENGINE_URL=http://localhost:8004

# OSRM (OpenStreetMap Routing Machine)
OSRM_BASE_URL=https://router.project-osrm.org

# Gemini API (if used)
GEMINI_API_KEY=
