# Django Core Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL Database (Supabase / any Postgres provider)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Brevo (Sendinblue) Email API Configuration
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-email@domain.com
BREVO_SENDER_NAME=KisanConnect Platform
DEFAULT_FROM_EMAIL=your-verified-email@domain.com

# Razorpay Credentials
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
